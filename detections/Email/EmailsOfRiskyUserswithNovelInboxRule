let threshold = 5m;
//Get Current risky users
let RiskyUsers=
IdentityInfo
    | summarize arg_max(TimeGenerated,*) by AccountObjectId
    | where RiskStatus in~ ("AtRisk", "ConfirmedCompromised")
    | project AccountObjectId, AccountUpn, EmailAddress, IsAccountEnabled, RiskLevel;
//Use risky users to search for 1st time new-inbox rule creation
let RiskyRule = 
RiskyUsers
| join kind=inner CloudAppEvents on $left.AccountObjectId == $right.AccountObjectId
| extend LastSeenForUser_ActionType = parse_json(LastSeenForUser)["ActionType"]
| where LastSeenForUser_ActionType == -1
| where ActionType == @"New-InboxRule"
| where Application == @"Microsoft Exchange Online"
| project RuleCreationTime = TimeGenerated, AccountObjectId;
//Search for mail events that followed by threshold
RiskyRule
| join kind=inner EmailEvents on $left.AccountObjectId == $right.SenderObjectId
| where TimeGenerated between (RuleCreationTime .. (RuleCreationTime + threshold))
