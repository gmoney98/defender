DeviceBaselineComplianceProfiles
| join DeviceBaselineComplianceAssessment on ProfileId
| where OSPlatform contains "Server"
| where IsCompliant == 0 and IsApplicable == 1 and IsExempt == 0
| join kind=leftouter DeviceBaselineComplianceAssessmentKB on ConfigurationId 
| summarize ConfigsImpacted = make_set(ConfigurationName), ConfigID = make_set(ConfigurationId), ConfigCount =count_distinct(ConfigurationId) by DeviceName
| sort by ConfigCount